@page "/processos"

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="fw-bold mb-1">Controle de Processos</h2>
	</div>
</div>

<div class="custom-table-card">
	<div class="table-responsive">

		<table class="table align-middle">

			<thead>
				<tr>
					<th>ID</th>
					<th>Número</th>
					<th>Interessado</th>
					<th>Assuntos</th>
					<th>Situação</th>
					<th>Ações</th>
				</tr>
			</thead>

			<tbody>
				<tr>
					<td>1</td>
					<td>2026/0001</td>
					<td>João Paulo</td>
					<td class="text-truncate">Solicitação de Isenção de IPTU</td>
					<td>
						<i class="bi bi-clock"></i> Pendente
					</td>
					<td class="text-end">
						<div class="btn-group btn-group-sm">
							<a href="#" class="btn btn-light border text-primary" tittle="Editar">
								<i class="bi bi-pencil"></i>
							</a>
							<a href="#" class="btn btn-light border text-primary" tittle="Excluir">
									<i class="bi bi-trash"></i>
							</a>
						</div>
					</td>
				</tr>

				<tr>
					<td>2</td>
					<td>2026/0002</td>
					<td>Maria Gasolina</td>
					<td class="text-truncate">Solicitação de Isenção de IPTU</td>
					<td>
						<i class="bi bi-check"></i> Concluído
					</td>
					<td class="text-end">
						<div class="btn-group btn-group-sm">
							<a href="#" class="btn btn-light border text-primary" tittle="Editar">
								<i class="bi bi-pencil"></i>
							</a>
							<a href="#" class="btn btn-light border text-primary" tittle="Excluir">
								<i class="bi bi-trash"></i>
							</a>
						</div>
					</td>
				</tr>
			</tbody>

		</table>
	</div>
</div>
